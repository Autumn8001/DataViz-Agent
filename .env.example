# -----------------------------------------------------------------------------
# DataViz Agent 环境变量模版示例
# -----------------------------------------------------------------------------

# 大模型 API 密钥 (默认支持智谱清言/OpenAI 标准格式)
OPENAI_API_KEY=your_llm_api_key_here

# 大模型 API 基础地址 (例如智谱：https://open.bigmodel.cn/api/paas/v4/)
BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# PostgreSQL 数据库连接 URI (主打持久化聊天状态)
POSTGRES_URI=postgresql://dataviz_user:dataviz_password@localhost:5432/dataviz_memory?sslmode=disable
